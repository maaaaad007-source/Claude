# Copy to .streamlit/secrets.toml for local runs, or paste the same lines into
# Streamlit Cloud under: share.streamlit.io -> your app -> ⋮ -> Settings ->
# Secrets. Keys set here are used automatically on every run — the sidebar
# boxes are only needed as a per-session override.
#
# secrets.toml is gitignored. Never commit a real key.

# Search provider. Needed on hosted deployments, whose shared IPs are blocked
# by search engines. Free tier at https://serper.dev
SERPER_API_KEY = "your-serper-key-here"

# Optional alternative search provider: https://brave.com/search/api/
# BRAVE_API_KEY = "your-brave-key-here"

# Optional. Returns real, observed email addresses: https://hunter.io
# HUNTER_API_KEY = "your-hunter-key-here"
